# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://bike_connect:bike_connect_dev@localhost:5432/bike_connect

# Auth
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
JWT_SECRET=<random 256-bit string>
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Image Storage (choose one: cloudinary | local)
IMAGE_STORAGE=local
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
LOCAL_UPLOAD_DIR=./uploads

# Rate Limiting (applies to /api requests per IP per window; static images are NOT counted)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
